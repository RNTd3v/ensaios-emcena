rules_version = '2';

// Arquivos de músicas e figurinos, em `cenas/{cenaId}/...` (ou `cenas/geral/...` quando não são de
// nenhuma cena). Quem pode cadastrar/editar é decidido no Firestore (coleções `musicas` e
// `figurinos` em firestore.rules: admin, equipe responsável, participantes da cena pra figurino) —
// cross-service `firestore.get()` aqui no Storage não funcionou de forma confiável nesse projeto,
// então o Storage em si só exige estar autenticado + limite de tamanho/tipo do arquivo. Um upload
// direto por fora do app fica órfão: nunca aparece, já que o doc no Firestore é o que é exibido.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    match /cenas/{cenaId}/figurino/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn();
    }

    match /cenas/{cenaId}/musicas/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if isSignedIn();
    }
  }
}
