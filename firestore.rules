rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: usuário autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && userDoc().role == 'admin';
    }

    function isLider() {
      return isAuthenticated() && userDoc().role == 'lider';
    }

    // Inscrito com acesso ativo (não revogado)
    function isActiveParticipant() {
      return isAuthenticated() && userDoc().active == true;
    }

    // Usuários: o próprio usuário sempre pode ler seu documento (inclusive antes de existir,
    // ensureUserDoc verifica existência antes de criar, no primeiro login). Admin lê todos.
    // Líder também lê todos, pra poder selecionar participantes ao montar um elenco.
    match /users/{userId} {
      allow read: if isAdmin() || isLider() || (isAuthenticated() && request.auth.uid == userId);
      // Criação automática no primeiro login (ensureUserDoc), sempre como 'participante' e ativo
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == 'participante'
        && request.resource.data.active == true;
      // Promover a admin, revogar acesso (active=false) etc: só admin
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Inscrições: cada participante só vê/edita a própria; admin vê e gerencia todas.
    // Só pode criar/editar enquanto o acesso estiver ativo (não revogado).
    match /inscricoes/{userId} {
      allow read: if isAdmin() || isLider() || (isAuthenticated() && request.auth.uid == userId);
      allow list: if isAdmin() || isLider();
      allow create: if isAuthenticated() && request.auth.uid == userId && isActiveParticipant();
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && isActiveParticipant());
      allow delete: if isAdmin();
    }

    // Configurações do espetáculo (nome, pôster, data): leitura pública, escrita só admin
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Elencos/grupos de ensaio: admin vê/gerencia todos. Líder só os que ele lidera (liderUid),
    // e só pode criar um elenco novo se colocar a si mesmo como líder.
    // "Excluir" é soft delete (ativo=false) via update; líder pode desativar o próprio elenco mas
    // não reativar (só admin) nem excluir de verdade (delete é ação separada, só admin).
    match /elencos/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.liderUid == request.auth.uid);
      allow create: if isAdmin() || (isLider() && request.resource.data.liderUid == request.auth.uid);
      allow update: if isAdmin()
        || (isAuthenticated() && resource.data.liderUid == request.auth.uid
            && !(resource.data.ativo == false && request.resource.data.ativo == true));
      allow delete: if isAdmin();
    }
  }
}
