rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: usuário autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && userDoc().role == 'admin';
    }

    function isLider() {
      return isAuthenticated() && userDoc().role == 'lider';
    }

    // Inscrito com acesso ativo (não revogado)
    function isActiveParticipant() {
      return isAuthenticated() && userDoc().active == true;
    }

    // Usuários: qualquer autenticado lê todos os perfis — é o que alimenta foto/nome em toda a
    // UI (cenas, personagens, participantes etc.), não só quem gerencia a cena.
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Criação automática no primeiro login (ensureUserDoc), sempre como 'participante' e ativo
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == 'participante'
        && request.resource.data.active == true;
      // Promover a admin, revogar acesso (active=false) etc: só admin
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Inscrições: cada participante só vê/edita a própria; admin vê e gerencia todas.
    // Só pode criar/editar enquanto o acesso estiver ativo (não revogado).
    match /inscricoes/{userId} {
      allow read: if isAdmin() || isLider() || (isAuthenticated() && request.auth.uid == userId);
      allow list: if isAdmin() || isLider();
      allow create: if isAuthenticated() && request.auth.uid == userId && isActiveParticipant();
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && isActiveParticipant());
      allow delete: if isAdmin();
    }

    // Configurações do espetáculo (nome, pôster, data): leitura pública, escrita só admin
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cenas: todo mundo autenticado pode ver, mas cada um só as cenas que dizem respeito a ele —
    // admin vê todas; líder só as que ele lidera (liderUid); participante só as que participa
    // (array-contains). Só admin cria. "Excluir" é soft delete (ativo=false) via update; líder
    // pode desativar a própria cena mas não reativar (só admin) nem excluir de verdade (delete é
    // ação separada, só admin). `musicas` é campo admin-only mesmo pro líder — ele pode mexer em
    // qualquer outro campo (nome, figurinos, personagens etc.), mas não pode alterar `musicas`
    // (updateCenaMusicas só é chamado pela UI quando isAdmin, mas a regra reforça isso mesmo se
    // alguém tentar direto pelo client). Qualquer participante da cena (não só líder/admin) pode
    // mexer em `figurinos` (fotos de referência) e `personagens` (a "ficha do personagem" que o
    // próprio ator/atriz preenche na página do personagem) — mas só nesses campos, nada mais; a UI
    // garante que cada um só edita a própria ficha dentro do array, a regra não valida isso.
    match /cenas/{id} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.liderUid == request.auth.uid)
        || (isAuthenticated() && request.auth.uid in resource.data.participantes);
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isAuthenticated() && resource.data.liderUid == request.auth.uid
            && !(resource.data.ativo == false && request.resource.data.ativo == true)
            && request.resource.data.musicas == resource.data.musicas)
        || (isAuthenticated() && request.auth.uid in resource.data.participantes
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['figurinos', 'personagens', 'updatedByUid', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Catálogo de personagens (tela de Personagens): só admin lê e escreve. Os personagens em si
    // continuam dentro de cada cena — aqui ficam só os criados pela tela, inclusive os sem cena.
    match /personagens/{id} {
      allow read, write: if isAdmin();
    }

    // Locais de ensaio: qualquer autenticado lê (aparecem no ensaio e no seletor do líder),
    // só admin cadastra/edita/exclui.
    match /locais/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Oração: `oracao/config` guarda líder, assistentes e orientações. Admin define a equipe;
    // líder/assistente só editam as orientações.
    function oracaoConfig() {
      return get(/databases/$(database)/documents/oracao/config).data;
    }
    function isEquipeOracao() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/oracao/config)
        && (oracaoConfig().get('liderUid', '') == request.auth.uid
            || request.auth.uid in oracaoConfig().get('assistentes', []));
    }

    match /oracao/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin()
        || (isEquipeOracao() && resource != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orientacoes', 'updatedAt']));
    }

    // Horário de oração de cada pessoa (id = uid): todos veem (a Home mostra quem está orando);
    // cada um mexe no seu, e admin/equipe da oração podem ajustar o de qualquer um.
    match /horariosOracao/{uid} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == uid || isAdmin() || isEquipeOracao());
    }

    // Pedidos de oração: todos leem, só admin/equipe da oração cadastram e editam.
    match /pedidosOracao/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isEquipeOracao();
    }

    // Equipes de staff: todos leem. Admin cria/exclui e mexe em tudo; o líder da equipe mexe em
    // membros, assistentes, descrição e prazo do figurino — mas não troca nome, ícone, líder nem o
    // que a equipe gerencia. Assistentes só mexem no prazo do figurino.
    match /equipes/{id} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isAuthenticated()
            && resource.data.get('liderUid', '') == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros', 'assistentes', 'descricao', 'prazoFigurino']))
        || (isAuthenticated()
            && request.auth.uid in resource.data.get('assistentes', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prazoFigurino']));

      // Tarefas da equipe: todos leem. Admin, líder e assistentes criam, editam e excluem;
      // os demais membros só mudam o status. Bloqueado/cancelado sempre com justificativa.
      match /tarefas/{tarefaId} {
        function equipe() {
          return get(/databases/$(database)/documents/equipes/$(id)).data;
        }
        function gerenciaEquipe() {
          return isAdmin()
            || (isAuthenticated()
                && (equipe().get('liderUid', '') == request.auth.uid || request.auth.uid in equipe().get('assistentes', [])));
        }
        function justificativaOk() {
          return !(request.resource.data.status in ['bloqueado', 'cancelado'])
            || (request.resource.data.get('justificativa', '') is string
                && request.resource.data.get('justificativa', '').size() > 0);
        }
        function statusValido() {
          return request.resource.data.status in ['a_fazer', 'fazendo', 'feito', 'bloqueado', 'cancelado'];
        }

        allow read: if isAuthenticated();
        allow create: if gerenciaEquipe() && statusValido() && justificativaOk();
        allow update: if statusValido() && justificativaOk()
          && (gerenciaEquipe()
              || (isAuthenticated()
                  && request.auth.uid in equipe().get('membros', [])
                  && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status', 'justificativa', 'statusAtualizadoPorUid', 'statusAtualizadoEm'])));
        allow delete: if gerenciaEquipe();
      }
    }

    // Músicas e figurinos (coleções próprias, cena opcional). Quem cadastra em nome da peça: admin
    // e membros de uma equipe cuja `gerencia` inclui o tipo — o doc traz o `equipeId` em nome de
    // quem foi gravado (o Firestore não consegue procurar "alguma equipe" da pessoa).
    function membroDeEquipeQueGerencia(equipeId, tipo) {
      return equipeId is string
        && exists(/databases/$(database)/documents/equipes/$(equipeId))
        && tipo in get(/databases/$(database)/documents/equipes/$(equipeId)).data.get('gerencia', [])
        && request.auth.uid in get(/databases/$(database)/documents/equipes/$(equipeId)).data.get('membros', []);
    }
    function cenaDoc(cenaId) {
      return get(/databases/$(database)/documents/cenas/$(cenaId)).data;
    }

    match /musicas/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin()
        || (isAuthenticated() && membroDeEquipeQueGerencia(request.resource.data.get('equipeId', null), 'musicas'));
      allow delete: if isAdmin()
        || (isAuthenticated() && membroDeEquipeQueGerencia(resource.data.get('equipeId', null), 'musicas'));
    }

    // Figurinos: admin e a equipe responsável cadastram/editam tudo (referências da peça). O
    // elenco manda a foto do próprio figurino pela página do personagem: entra `pendente` e o líder
    // da cena aprova/reprova (só os campos de avaliação). Quem mandou pode excluir enquanto não foi
    // aprovada.
    match /figurinos/{id} {
      allow read: if isAuthenticated();
      allow create: if isAdmin()
        || (isAuthenticated() && membroDeEquipeQueGerencia(request.resource.data.get('equipeId', null), 'figurinos'))
        || (isAuthenticated()
            && request.resource.data.get('cenaId', null) is string
            && request.resource.data.get('personagemId', null) is string
            && request.auth.uid in cenaDoc(request.resource.data.cenaId).participantes
            && request.resource.data.uploadedByUid == request.auth.uid
            && request.resource.data.get('aprovacao', null) == 'pendente');
      allow update: if isAdmin()
        || (isAuthenticated() && membroDeEquipeQueGerencia(request.resource.data.get('equipeId', null), 'figurinos'))
        || (isAuthenticated()
            && resource.data.get('cenaId', null) is string
            && cenaDoc(resource.data.cenaId).get('liderUid', '') == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['aprovacao', 'avaliadoPorUid', 'avaliadoEm', 'motivoReprovacao'])
            && request.resource.data.aprovacao in ['aprovado', 'reprovado']);
      allow delete: if isAdmin()
        || (isAuthenticated() && membroDeEquipeQueGerencia(resource.data.get('equipeId', null), 'figurinos'))
        || (isAuthenticated()
            && resource.data.uploadedByUid == request.auth.uid
            && resource.data.get('aprovacao', null) != 'aprovado');
    }

    // Metas e gastos. `financeiro/config` guarda líder, assistentes e a meta; `financeiro/resumo`
    // é o formato antigo (só lido pra importar e depois apagado). Todos leem; admin define a
    // equipe; líder/assistentes mexem na meta e nos lançamentos.
    function financeiroConfig() {
      return get(/databases/$(database)/documents/financeiro/config).data;
    }
    function isEquipeFinanceiro() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/financeiro/config)
        && (financeiroConfig().get('liderUid', '') == request.auth.uid
            || request.auth.uid in financeiroConfig().get('assistentes', []));
    }

    match /financeiro/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin()
        || (id == 'config' && isEquipeFinanceiro() && resource != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['metaTotal', 'updatedAt']));
    }

    // Entradas lançadas à mão (doces, ofertas, outros) e gastos (com comprovante no Storage).
    match /entradas/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isEquipeFinanceiro();
    }
    match /gastos/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isEquipeFinanceiro();
    }

    // Versículos (sorteados na Home): qualquer autenticado lê, só admin cadastra/edita/exclui.
    match /versiculos/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Ensaios: uma ocorrência (data+horário) de uma cena, confirmada ou cancelada. Mesma
    // visibilidade da cena correspondente (checada via get() na cena referenciada); confirmar
    // (create), cancelar/reconfirmar (update completo) é admin, o líder ou um assistente daquela cena — cancelar
    // não apaga o documento, só marca `canceledByUid`/`canceledAt`, pra manter o histórico visível.
    // Participante da cena também pode dar update, mas só na própria resposta: se incluir/tirar
    // de `presencas` e `ausentes` (nunca outra pessoa nem outro campo) — ver listaPropriaOk. O
    // motivo da ausência fica na subcoleção `ausencias`, com leitura restrita. A regra não valida se a pessoa
    // tem personagem nem a janela de horário — isso é responsabilidade do cliente (regras do
    // Firestore não conseguem inspecionar o array `personagens` pra achar `participanteUid`).
    // Participante mexendo na própria resposta de um ensaio: nas listas `presencas` e `ausentes`
    // só pode se incluir ou se tirar (nada mais muda no array)...
    function listaPropriaOk(campo) {
      let antes = resource.data.get(campo, []);
      let depois = request.resource.data.get(campo, []);
      return depois == antes
        || (!(request.auth.uid in antes) && depois == antes.concat([request.auth.uid]))
        || ((request.auth.uid in antes) && depois == antes.removeAll([request.auth.uid]));
    }

    // ...e no mapa legado `ausencias` (motivos gravados no próprio ensaio, antes de irem pra
    // subcoleção) só pode mexer na própria chave — na prática, só pra apagá-la.
    function ausenciaPropriaOk() {
      return request.resource.data.get('ausencias', {}).diff(resource.data.get('ausencias', {})).affectedKeys().hasOnly([request.auth.uid]);
    }

    // Quem cuida do dia a dia dos ensaios de uma cena: o líder e os assistentes dela.
    function gerenciaEnsaios(cena) {
      return isAuthenticated()
        && (cena.get('liderUid', '') == request.auth.uid || request.auth.uid in cena.get('assistentes', []));
    }

    match /ensaios/{id} {
      allow read: if isAdmin()
        || (isAuthenticated()
            && get(/databases/$(database)/documents/cenas/$(resource.data.cenaId)).data.liderUid == request.auth.uid)
        || (isAuthenticated()
            && request.auth.uid in get(/databases/$(database)/documents/cenas/$(resource.data.cenaId)).data.participantes);
      allow create: if isAdmin()
        || gerenciaEnsaios(get(/databases/$(database)/documents/cenas/$(request.resource.data.cenaId)).data);
      allow update: if isAdmin()
        || gerenciaEnsaios(get(/databases/$(database)/documents/cenas/$(resource.data.cenaId)).data)
        || (isAuthenticated()
            && request.auth.uid in get(/databases/$(database)/documents/cenas/$(resource.data.cenaId)).data.participantes
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['presencas', 'ausentes', 'ausencias'])
            && listaPropriaOk('presencas')
            && listaPropriaOk('ausentes')
            && ausenciaPropriaOk());
      allow delete: if isAdmin()
        || (isAuthenticated()
            && get(/databases/$(database)/documents/cenas/$(resource.data.cenaId)).data.liderUid == request.auth.uid);

      // Motivo de quem avisou que não vai (um doc por pessoa, id = uid). Separado do ensaio pra
      // ficar privado: só admin, o líder e os assistentes da cena e a própria pessoa leem. Quem não vai (sem o
      // motivo) fica visível pra todos em `ausentes`, no próprio ensaio.
      match /ausencias/{uid} {
        function cenaDoEnsaio() {
          return get(/databases/$(database)/documents/cenas/$(get(/databases/$(database)/documents/ensaios/$(id)).data.cenaId)).data;
        }
        allow read: if isAdmin()
          || (isAuthenticated() && request.auth.uid == uid)
          || gerenciaEnsaios(cenaDoEnsaio());
        allow write: if isAdmin()
          || (isAuthenticated() && request.auth.uid == uid && request.auth.uid in cenaDoEnsaio().participantes)
          || gerenciaEnsaios(cenaDoEnsaio());
      }
    }
  }
}
